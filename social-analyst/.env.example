# `uv run sma setup keys` fills this in from a local form (or copy to .env by hand). Gitignored.
# Never commit real keys. Any VAR can instead be VAR_FILE=/path/to/keyfile.

# --- Buffer (required) — personal API key from publish.buffer.com/settings/api (see docs/buffer-setup.md)
BUFFER_API_KEY=
# More Buffer logins (other clients/brands): BUFFER_API_KEY_<NAME>=...
# BUFFER_API_KEY_CLIENTA=

# --- Gemini (required for `sma video`) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_VIDEO_MODEL=gemini-3.8-flash      # model ids churn; change here, not in code
# GEMINI_VIDEO_FPS=2                       # 3-4 for very fast-cut edits
# GEMINI_MEDIA_RESOLUTION=MEDIA_RESOLUTION_HIGH

# --- Deep analytics (optional) — see docs/connect-*.md
# GOOGLE_OAUTH_CLIENT_ID=                  # YouTube Analytics (Desktop OAuth client)
# GOOGLE_OAUTH_CLIENT_SECRET=
# YOUTUBE_CLIENT_SECRET_FILE=              # alternative: path to the downloaded client_secret.json
# INSTAGRAM_ACCESS_TOKEN=                  # Instagram Graph token (per account: INSTAGRAM_ACCESS_TOKEN_<NAME>)
# INSTAGRAM_GRAPH_VERSION=v24.0
# THREADS_ACCESS_TOKEN=                    # Threads insights (per account: THREADS_ACCESS_TOKEN_<NAME>)
# X_CLIENT_ID=                             # X OAuth 2.0 (paid API) — docs/connect-x.md
# X_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=                      # needs Community Management API approval — docs/connect-linkedin.md
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_API_VERSION=202610
# SMA_OAUTH_PORT=8765                      # redirect http://localhost:<port>/callback for X/LinkedIn

# --- Discovery (optional)
# APIFY_TOKEN=                             # Apify MCP scrapers (paid per result)
# INSTALOADER_SESSION_USER=                # after `uv run instaloader --login <throwaway>`
# YTDLP_COOKIES_FROM_BROWSER=firefox       # for login-walled videos

# --- Misc
# SMA_TIMEZONE=UTC                         # fallback when an account has none
# SMA_ENV_FILES=~/somewhere/.env           # extra env files to read (colon-separated)
